{
  "name": "rehearsal",
  "displayName": "Rehearsal",
  "description": "See what a database change will actually do to your data, before you do it.",
  "version": "0.1.0",
  "publisher": "azizguenni",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sql",
    "onView:rehearsal.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rehearsal",
          "title": "Rehearsal",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "rehearsal": [
        {
          "id": "rehearsal.sidebar",
          "name": "Database",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "rehearsal.preview",
        "title": "Preview",
        "category": "Rehearsal",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon-dark.svg"
        }
      },
      {
        "command": "rehearsal.exploreSchema",
        "title": "Explore Schema",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.appliedChanges",
        "title": "Applied Changes",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.compareSchemas",
        "title": "Compare With Another Database",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.schemaHealth",
        "title": "Schema Health Report",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.pendingMigrations",
        "title": "Preview Pending Migrations",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.suggestIndexes",
        "title": "Would an Index Help?",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.testConnection",
        "title": "Test Connection",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.disconnect",
        "title": "Disconnect",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.previewFile",
        "title": "Preview with Rehearsal",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.switchConnection",
        "title": "Switch Connection",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.previewStatement",
        "title": "Preview This Statement",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.trySample",
        "title": "Try It on a Sample Database",
        "category": "Rehearsal"
      },
      {
        "command": "rehearsal.ormDrift",
        "title": "Compare With the Prisma Schema",
        "category": "Rehearsal"
      }
    ],
    "configuration": [
      {
        "title": "Rehearsal",
        "order": 0,
        "properties": {
          "rehearsal.connectionString": {
            "type": "string",
            "default": "",
            "markdownDescription": "Postgres connection string. Use an environment variable reference such as `${env:DATABASE_URL}` — never paste a password here. Leave empty to read `REHEARSAL_DATABASE_URL` or `DATABASE_URL` from a `.env` file in the workspace root.",
            "order": 0
          },
          "rehearsal.envFile": {
            "type": "string",
            "default": ".env",
            "description": "Path (relative to the workspace root) of the .env file to read the connection string from.",
            "order": 1
          },
          "rehearsal.productionPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "prod",
              "production",
              "live"
            ],
            "description": "Case-insensitive regular expressions. If a connection string matches any of them, Rehearsal refuses to connect.",
            "order": 2
          },
          "rehearsal.allowedConnections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Connections that are exempt from production detection, written as `host:port/database`. Adding an entry here is a deliberate act — there is no one-click override.",
            "order": 3
          }
        }
      },
      {
        "title": "Rehearsal: Safety thresholds",
        "order": 1,
        "properties": {
          "rehearsal.cautionRowThreshold": {
            "type": "number",
            "default": 100,
            "description": "Rows affected above which a statement is marked 'caution'.",
            "order": 0
          },
          "rehearsal.destructiveRowThreshold": {
            "type": "number",
            "default": 1000,
            "description": "Rows affected above which a statement is marked 'destructive'.",
            "order": 1
          },
          "rehearsal.largeTableThreshold": {
            "type": "number",
            "default": 100000,
            "description": "Row count above which a table is treated as large for lock and index-build warnings.",
            "order": 2
          },
          "rehearsal.statementTimeoutMs": {
            "type": "number",
            "default": 5000,
            "minimum": 100,
            "description": "statement_timeout applied inside every preview transaction.",
            "order": 3
          },
          "rehearsal.lockTimeoutMs": {
            "type": "number",
            "default": 2000,
            "minimum": 100,
            "maximum": 10000,
            "description": "lock_timeout applied inside every preview transaction. A preview must never be the cause of a lock queue.",
            "order": 4
          },
          "rehearsal.sampleSize": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 200,
            "description": "How many affected rows to show in a before/after sample.",
            "order": 5
          }
        }
      },
      {
        "title": "Rehearsal: Measuring",
        "order": 2,
        "properties": {
          "rehearsal.productionRows": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "number"
            },
            "markdownDescription": "How many rows each table holds in the database you actually deploy to, as `{\"users\": 40000000}`. Every count in a preview is exact about the database it measured; given this, each finding also says what the same change costs at the size that matters. Nothing is read from that database — these are numbers you supply.",
            "order": 0
          },
          "rehearsal.explainAnalyze": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Capture a query plan for each UPDATE, DELETE and INSERT. This runs the statement a **second time** inside the same rolled-back transaction, so it roughly doubles how long a preview takes on a large statement. Off by default for that reason.",
            "order": 1
          },
          "rehearsal.previewOnSave": {
            "type": "boolean",
            "default": false,
            "description": "Re-run the preview when you save a file the Rehearsal panel is already showing. Only that file, and only when a connection is already open — saving never opens one.",
            "order": 2
          },
          "rehearsal.codeLens": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "Show a line above each statement in a migration file: its verdict once it has been previewed, or a link to preview just that statement."
          }
        }
      },
      {
        "title": "Rehearsal: MySQL",
        "order": 3,
        "properties": {
          "rehearsal.mysql.measureOnCopy": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "On MySQL, measure a schema change by **running it against a copy of the table** rather than only by counting. MySQL commits DDL the moment it runs, so there is no transaction to roll one back — a copy is the only way to see what the server really does.\n\nThis is the one setting that causes a write. The copy carries a reserved `_rehearsal_clone_` prefix, is never the table you named, is dropped when the measurement finishes, and is swept up on the next connection if a crash left it behind. Your table is never touched.\n\nWhat it buys: the server's own error — *Incorrect integer value: 'a@b.com' for column 'email' at row 13* — instead of *88 rows cannot convert*. It cannot tell you about foreign key violations, because `CREATE TABLE … LIKE` does not copy foreign keys; the counts remain the authority for those.",
            "order": 0
          },
          "rehearsal.mysql.measureOnCopyRowLimit": {
            "type": "number",
            "default": 500000,
            "description": "Above this many rows, Rehearsal will not copy a table to measure against — the copy costs more than the better answer is worth, and the counted result is used instead.",
            "order": 1
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rehearsal.preview",
          "when": "resourceLangId == sql || resourceFilename =~ /\\.mongodb\\.js$/ || resourcePath =~ /[\\\\/](migrations|operations)[\\\\/][^\\\\/]+\\.js$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "rehearsal.preview",
          "when": "resourceLangId == sql || resourceFilename =~ /\\.mongodb\\.js$/ || resourcePath =~ /[\\\\/](migrations|operations)[\\\\/][^\\\\/]+\\.js$/",
          "group": "rehearsal@1"
        },
        {
          "command": "rehearsal.suggestIndexes",
          "when": "resourceLangId == sql",
          "group": "rehearsal@2"
        }
      ],
      "explorer/context": [
        {
          "command": "rehearsal.previewFile",
          "when": "resourceLangId == sql || resourceFilename =~ /\\.mongodb\\.js$/ || resourcePath =~ /[\\\\/](migrations|operations)[\\\\/][^\\\\/]+\\.js$/",
          "group": "rehearsal@1"
        }
      ],
      "commandPalette": [
        {
          "command": "rehearsal.previewFile",
          "when": "false"
        },
        {
          "command": "rehearsal.previewStatement",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rehearsal.preview",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus && (resourceLangId == sql || resourceFilename =~ /\\.mongodb\\.js$/ || resourcePath =~ /[\\\\/](migrations|operations)[\\\\/][^\\\\/]+\\.js$/)"
      },
      {
        "command": "rehearsal.suggestIndexes",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && resourceLangId == sql"
      },
      {
        "command": "rehearsal.exploreSchema",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "walkthroughs": [
      {
        "id": "rehearsal.start",
        "title": "Get started with Rehearsal",
        "description": "See what a database change will do to your data before you make it.",
        "steps": [
          {
            "id": "sample",
            "title": "See it work on a sample database",
            "description": "No setup and no credentials: a small SQLite file, a sample migration, and a real preview.\n[Try the sample](command:rehearsal.trySample)",
            "media": {
              "markdown": "media/walkthrough/sample.md"
            },
            "completionEvents": [
              "onCommand:rehearsal.trySample"
            ]
          },
          {
            "id": "connect",
            "title": "Connect your own database",
            "description": "Paste a connection string. Postgres, MySQL, MongoDB and SQLite.\n[Open the Rehearsal panel](command:rehearsal.sidebar.focus)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onView:rehearsal.sidebar"
            ]
          },
          {
            "id": "preview",
            "title": "Preview a migration",
            "description": "Open a migration and measure it against your data.\n[Preview the open file](command:rehearsal.preview)",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:rehearsal.preview"
            ]
          },
          {
            "id": "explore",
            "title": "Explore the schema",
            "description": "The database as a diagram you can change, with every change previewed first.\n[Explore the schema](command:rehearsal.exploreSchema)",
            "media": {
              "markdown": "media/walkthrough/explore.md"
            },
            "completionEvents": [
              "onCommand:rehearsal.exploreSchema"
            ]
          }
        ]
      }
    ]
  },
  "bin": {
    "rehearsal": "./dist/cli.js"
  },
  "icon": "media/marketplace-icon.png",
  "scripts": {
    "demo": "npm run compile-tests && node scripts/demo.mjs",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vsix": "npm run package && vsce package --no-dependencies",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "npm run compile-tests && node --test --test-concurrency=4 \"out/test/**/*.test.js\"",
    "test:ui": "npm run compile-tests && node --test \"out/test/ui/*.test.js\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "testbed:db": "node testbed/postgres-shop/scripts/local-db.mjs",
    "testbed:mysql": "node testbed/mysql-blog/scripts/local-db.mjs",
    "testbed:mongo": "node testbed/mongo-analytics/scripts/local-db.mjs",
    "testbed:sqlite": "node testbed/sqlite-notes/scripts/local-db.mjs",
    "testbed:seed": "node testbed/postgres-shop/scripts/setup.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "gifenc": "^1.0.3",
    "mongodb": "^7.6.0",
    "mongodb-memory-server": "^11.2.0",
    "mysql-memory-server": "^1.16.0",
    "mysql2": "^3.24.2",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "mysql",
    "mongodb",
    "sqlite",
    "sql",
    "migration",
    "database",
    "erd",
    "schema",
    "diagram",
    "preview",
    "dry run",
    "dry-run",
    "safety"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/azyzex/Rehearsal.git"
  },
  "homepage": "https://github.com/azyzex/Rehearsal#readme",
  "bugs": {
    "url": "https://github.com/azyzex/Rehearsal/issues"
  },
  "galleryBanner": {
    "color": "#161d2b",
    "theme": "dark"
  },
  "qna": "https://github.com/azyzex/Rehearsal/issues"
}
