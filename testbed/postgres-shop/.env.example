# Copy this file to .env in the same folder and paste your Neon connection
# string. .env is gitignored — the real one never gets committed.
#
# Neon gives you this on the project dashboard under "Connection string".
# Keep the ?sslmode=require on the end; Neon refuses plaintext connections.
DATABASE_URL=postgresql://USER:PASSWORD@ep-something-12345678.eu-central-1.aws.neon.tech/neondb?sslmode=require
