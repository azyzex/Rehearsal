.vscode/**
src/**
out/**
node_modules/**
.gitignore
.env
esbuild.js
tsconfig*.json
eslint.config.mjs
REHEARSAL_SPEC.md
PUBLISHING.md
scripts/
testbed/
ui-shots/
media/__ui-*.html

# The demo. The Marketplace rewrites relative README links to the repository's
# raw URL, so the recording loads from GitHub rather than adding two megabytes
# to everyone's download.
media/demo.gif
media/demo-still.png
MANUAL-CHECK.md
examples/
*.tmp.mjs
*.tmp.ts

# Source maps. The production build does not emit them, but `vsce package` run
# on its own packages whatever is in dist/ — and a dev build there would ship
# the whole original TypeScript inside the extension.
dist/**/*.map

# Promo video work: kept in the repo folder, never shipped in the extension.
brag-output*/**
*.mp4
ROADMAP.md
